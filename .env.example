# Copy this file to .env for local development. These are development-only values.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
OTEL_MODE=disabled
# Optional local collector base URL. Required only when OTEL_MODE=otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_INSTANCE_ID=local-api
OTEL_TRACE_SAMPLE_RATIO=1.0
DATABASE_URL=postgresql+psycopg://creative_marketer_runtime:creative_marketer_runtime@localhost:5432/creative_marketer
EVENT_PUBLISHER_DATABASE_URL=postgresql+psycopg://creative_marketer_event_publisher:creative_marketer_event_publisher@localhost:5432/creative_marketer
MIGRATION_DATABASE_URL=postgresql+psycopg://creative_marketer_migrator:creative_marketer_migrator@localhost:5432/creative_marketer
DEV_IDENTITY_ENABLED=true
AUDIT_FINGERPRINT_KEY=local-only-audit-fingerprint-key-change-me
CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional local-only display name for obsidian:// links. This is not a filesystem path.
# NEXT_PUBLIC_OBSIDIAN_VAULT_NAME=Creative Marketer

# Local Obsidian Bridge only. Keep CM_API_TOKEN in your shell, never in committed config.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault
# CM_API_BASE_URL=http://localhost:8000
# CM_TENANT_ID=
# CM_API_TOKEN=

# Development-only private S3-compatible storage. Production values come from secret injection.
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=creative-marketer-assets
OBJECT_STORAGE_ACCESS_KEY_ID=creative-marketer-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=creative-marketer-local-secret
ASSET_UPLOAD_TTL_SECONDS=900
ASSET_DOWNLOAD_TTL_SECONDS=600

# Optional local durable-workflow spike service; ordinary API/web development does not use it.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
MODEL_PROVIDER_BACKEND=disabled
# OPENAI_API_KEY=              # Required only in the Researcher worker process
MEDIA_IMAGE_PROVIDER=disabled
MEDIA_VIDEO_PROVIDER=disabled
PRODUCTION_MAX_PLAN_COST_USD=100
# BYTEPLUS_LAS_API_KEY=        # Required only when MEDIA_VIDEO_PROVIDER=byteplus
AGENT_WORKLOAD_ID=local-agent-worker
# AGENT_RECOVERY_TENANT_ID=    # Required only for explicit recovery CLI operations
# AGENT_RECOVERY_OPERATOR_ID=local-recovery-operator
# BOOTSTRAP_TENANT_ID=         # Explicit dev-only Researcher bootstrap
# BOOTSTRAP_USER_ID=

# PostgreSQL container configuration
POSTGRES_DB=creative_marketer
POSTGRES_USER=creative_marketer_migrator
POSTGRES_PASSWORD=creative_marketer_migrator
