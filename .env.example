# ============================================================
# Creative Marketer — central local environment contract
# ============================================================
# Copy/merge with `make env-init`. Safe defaults never enable paid providers.

# ------------------------------------------------------------
# Application and observability
# ------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
OTEL_MODE=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_INSTANCE_ID=local-api
OTEL_TRACE_SAMPLE_RATIO=1.0

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://creative_marketer_runtime:creative_marketer_runtime@localhost:5432/creative_marketer
EVENT_PUBLISHER_DATABASE_URL=postgresql+psycopg://creative_marketer_event_publisher:creative_marketer_event_publisher@localhost:5432/creative_marketer
MIGRATION_DATABASE_URL=postgresql+psycopg://creative_marketer_migrator:creative_marketer_migrator@localhost:5432/creative_marketer
POSTGRES_DB=creative_marketer
POSTGRES_USER=creative_marketer_migrator
POSTGRES_PASSWORD=creative_marketer_migrator

# ------------------------------------------------------------
# Identity, audit, and browser boundary
# ------------------------------------------------------------
DEV_IDENTITY_ENABLED=true
AUDIT_FINGERPRINT_KEY=local-only-audit-fingerprint-key-change-me
CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------------------------
# Frontend public configuration (rebuild/restart web after edits)
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_OBSIDIAN_VAULT_NAME=

# ------------------------------------------------------------
# OpenAI model and image providers
# ------------------------------------------------------------
OPENAI_API_KEY=
MODEL_PROVIDER_BACKEND=disabled
MEDIA_IMAGE_PROVIDER=disabled

# ------------------------------------------------------------
# Seedance / BytePlus LAS
# ------------------------------------------------------------
BYTEPLUS_LAS_API_KEY=
BYTEPLUS_LAS_BASE_URL=https://operator.las.ap-southeast-1.bytepluses.com
MEDIA_VIDEO_PROVIDER=disabled

# ------------------------------------------------------------
# Spend protection and operator-only live acceptance
# ------------------------------------------------------------
ALLOW_BILLABLE_MEDIA=false
RUN_LIVE_E2E=
LIVE_E2E_MAX_USD=10
LIVE_E2E_PRODUCT_ID=
PRODUCTION_MAX_PLAN_COST_USD=100

# ------------------------------------------------------------
# Private S3-compatible object storage
# ------------------------------------------------------------
OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=creative-marketer-assets
OBJECT_STORAGE_ACCESS_KEY_ID=creative-marketer-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=creative-marketer-local-secret
ASSET_UPLOAD_TTL_SECONDS=900
ASSET_DOWNLOAD_TTL_SECONDS=600
TEST_OBJECT_STORAGE_URL=http://localhost:9000

# ------------------------------------------------------------
# Temporal
# ------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TEST_SERVER_PATH=

# ------------------------------------------------------------
# Worker identities and explicit bootstrap/recovery inputs
# ------------------------------------------------------------
AGENT_WORKLOAD_ID=local-agent-worker
MEDIA_WORKLOAD_ACTOR_ID=
MEDIA_WORKLOAD_ID=local-media-worker
ASSEMBLY_WORKLOAD_ACTOR_ID=
ASSEMBLY_WORKLOAD_ID=local-assembly-worker
AGENT_RECOVERY_TENANT_ID=
AGENT_RECOVERY_OPERATOR_ID=
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_USER_ID=
BOOTSTRAP_PLATFORM_ACTOR_ID=

# ------------------------------------------------------------
# Obsidian bridge (CM_API_TOKEN is a local credential)
# ------------------------------------------------------------
OBSIDIAN_VAULT_PATH=
CM_API_BASE_URL=http://localhost:8000
CM_TENANT_ID=
CM_API_TOKEN=

# ------------------------------------------------------------
# Integration-test database roles (only used by make test-postgres)
# ------------------------------------------------------------
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://creative_marketer_migrator:creative_marketer_migrator@localhost:5432/creative_marketer
TEST_DATABASE_RUNTIME_URL=postgresql+psycopg://creative_marketer_runtime:creative_marketer_runtime@localhost:5432/creative_marketer
TEST_DATABASE_PUBLISHER_URL=postgresql+psycopg://creative_marketer_event_publisher:creative_marketer_event_publisher@localhost:5432/creative_marketer
