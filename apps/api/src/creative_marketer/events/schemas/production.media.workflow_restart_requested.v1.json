{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-event-type": "production.media.workflow_restart_requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "production_plan_id",
    "transition_id",
    "generation_job_ids",
    "reason_code"
  ],
  "properties": {
    "production_plan_id": { "type": "string", "format": "uuid" },
    "transition_id": { "type": "string", "format": "uuid" },
    "generation_job_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "reason_code": {
      "const": "TERMINAL_OR_MISSING_WORKFLOW_WITH_READY_JOBS"
    }
  }
}
