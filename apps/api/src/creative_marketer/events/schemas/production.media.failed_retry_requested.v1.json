{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-event-type": "production.media.failed_retry_requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "production_plan_id",
    "transition_id",
    "generation_job_ids",
    "provider_attempt_ids",
    "retry_reason"
  ],
  "properties": {
    "production_plan_id": { "type": "string", "format": "uuid" },
    "transition_id": { "type": "string", "format": "uuid" },
    "generation_job_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "provider_attempt_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "retry_reason": { "const": "CONFIRMED_PROVIDER_FAILURE" }
  }
}
