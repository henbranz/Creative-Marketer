{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "observations", "comparative_findings", "insight_candidates", "limitations", "next_experiments"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1200},
    "observations": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["statement", "source_ref", "window"], "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 500}, "source_ref": {"type": "string", "minLength": 1, "maxLength": 100}, "window": {"enum": ["+1h", "+6h", "+24h", "+72h", "+7d", "UNMATCHED"]}}}},
    "comparative_findings": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["comparison_id", "interpretation"], "properties": {"comparison_id": {"type": "string", "format": "uuid"}, "interpretation": {"type": "string", "minLength": 1, "maxLength": 500}}}},
    "insight_candidates": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["statement", "comparison_ids", "metric", "confidence", "scope", "limitations"], "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 800}, "comparison_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}, "metric": {"type": "string", "minLength": 1, "maxLength": 64}, "confidence": {"enum": ["LOW", "MODERATE", "HIGH"]}, "scope": {"type": "object", "additionalProperties": false, "required": ["dimensions"], "properties": {"dimensions": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "value": {"type": ["string", "number", "boolean", "null"]}}}}}}, "limitations": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 300}}}}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "next_experiments": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["candidate_indexes", "hypothesis", "primary_variable", "controlled_elements", "target_metric", "platform", "recommended_measurement_window", "creative_direction", "rationale", "expected_learning"], "properties": {"candidate_indexes": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 9}}, "hypothesis": {"type": "string", "minLength": 1, "maxLength": 600}, "primary_variable": {"type": "string", "minLength": 1, "maxLength": 200}, "controlled_elements": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 200}}, "target_metric": {"type": "string", "minLength": 1, "maxLength": 64}, "platform": {"type": "string", "minLength": 1, "maxLength": 64}, "recommended_measurement_window": {"enum": ["+1h", "+6h", "+24h", "+72h", "+7d"]}, "creative_direction": {"type": "string", "minLength": 1, "maxLength": 800}, "rationale": {"type": "string", "minLength": 1, "maxLength": 600}, "expected_learning": {"type": "string", "minLength": 1, "maxLength": 600}}}}
  }
}
